# PaybotX POS — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ===== Payment Gateway Credentials =====
# Get these from your PaybotX/Valor merchant portal
PAYBOTX_MERCHANT_ID=
PAYBOTX_API_KEY=

# ===== CORS Origin =====
# Set this to your actual deployment domain
# Example: https://pos.yourrestaurant.com
CORS_ALLOWED_ORIGIN=http://localhost

# ===== Database Credentials =====
# Change these from defaults in production!
DB_USER=floreant
DB_PASS=floreant
MYSQL_ROOT_PASSWORD=rootpassword
